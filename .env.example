# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js secret for local development.
AUTH_SECRET="replace-with-a-long-random-secret"

# Razorpay billing
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CRON_SECRET=""
